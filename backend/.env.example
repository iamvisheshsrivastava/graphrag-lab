# Copy this to .env and fill in your keys

# LLM (OpenRouter is the primary provider; OpenAI is a fallback)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=z-ai/glm-4.6
OPENAI_API_KEY=sk-...

# Neo4j AuraDB (or self-hosted) — variable names must match what neo4j_service.py reads
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=neo4j

# Comma-separated list of extra allowed CORS origins (beyond localhost + the deployed frontend)
ALLOWED_ORIGINS=

# Optional API-key gate for write + LLM endpoints (see backend/security.py).
# Leave unset for the open public demo; set to require a matching X-API-Key
# header. If you set this, also set VITE_API_KEY in frontend/.env so the UI
# sends it.
API_KEY=

# Per-IP rate limit applied to the two endpoints that call OpenRouter
# (POST /graph/build, POST /query) — defaults shown, only need to set these
# to override.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=10
